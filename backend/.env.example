# Copy this file to .env and fill in your values. Never commit .env.

# Server. Locally the backend listens on 5175.
# On Azure App Service, PORT is set automatically: do not add it there.
PORT=5175
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Secret used to sign login tokens (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Azure Database for MySQL
DB_HOST=<your-server>.mysql.database.azure.com
DB_USER=<your-admin-user>
DB_PASSWORD=<your-password>
DB_NAME=authdb
DB_PORT=3306
