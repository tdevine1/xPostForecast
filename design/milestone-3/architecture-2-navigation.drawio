<mxfile host="drawio" agent="xPostForecast design examples"><diagram id="p0" name="Navigation design"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Architecture 2 of 3: Navigation Design" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#23465E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="c3" value="The pages a user can reach, the actions that move between them, and the login check that guards them." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7C8A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="Open the site&lt;br&gt;(any URL)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#23465E;strokeColor=#23465E;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="160" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Checking your session…&lt;/b&gt;&lt;br&gt;App asks the server&lt;br&gt;GET /auth/test" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="230" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Login page&lt;/b&gt;&lt;br&gt;/login" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="230" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Register page&lt;/b&gt;&lt;br&gt;/register" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="230" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Map page&lt;/b&gt;&lt;br&gt;/map&lt;br&gt;&lt;i&gt;logged-in users only&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="360" width="230" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="not logged in" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="logged in" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="170"/></Array></mxGeometry></mxCell><mxCell id="c12" value="login succeeds" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Logout,&lt;br&gt;or session expired (401)" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5A66;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="“Register here”&lt;br&gt;link" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="190" y="495" width="160" height="50" as="geometry"/></mxCell><mxCell id="c17" value="“Log in” link, or&lt;br&gt;registration succeeds" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="487" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Login check for each URL&lt;/b&gt;&lt;br&gt;&lt;table style='border-collapse:collapse;font-size:12px;margin-top:6px' cellpadding='5'&gt;&lt;tr style='background:#DCE6EC'&gt;&lt;th align='left'&gt;URL&lt;/th&gt;&lt;th align='left'&gt;Not logged in&lt;/th&gt;&lt;th align='left'&gt;Logged in&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/&lt;/td&gt;&lt;td&gt;→ /login&lt;/td&gt;&lt;td&gt;→ /map&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F4F7F9'&gt;&lt;td&gt;/login&lt;/td&gt;&lt;td&gt;Login page&lt;/td&gt;&lt;td&gt;→ /map&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/register&lt;/td&gt;&lt;td&gt;Register page&lt;/td&gt;&lt;td&gt;→ /map&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F4F7F9'&gt;&lt;td&gt;/map&lt;/td&gt;&lt;td&gt;→ /login&lt;/td&gt;&lt;td&gt;Map page&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DB;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="340" height="185" as="geometry"/></mxCell><mxCell id="c19" value="On the map page, choosing a month and clicking Fetch Data reloads the map without leaving the page." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B7C8A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="765" width="360" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>