<mxfile host="drawio" agent="xPostForecast design examples"><diagram id="p0" name="Client-server layered architecture"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Architecture 1 of 3: Client–Server, Layered Architecture" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#23465E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="c3" value="What runs where, and which part calls which. Arrows point from the caller to the part it calls." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7C8A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Azure Static Web Apps&lt;/b&gt;&lt;br&gt;serves the built app (HTML, JavaScript, CSS)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Client: the user's web browser" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#23465E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;fontColor=#23465E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="330" height="450" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;App&lt;/b&gt;&lt;br&gt;routes and login state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="65"