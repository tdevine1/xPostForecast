<mxfile host="drawio" agent="xPostForecast design examples"><diagram id="p0" name="Control flow: call hierarchy"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Architecture 3 of 3: Control Flow (Hierarchical Calling Structure)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#23465E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1300" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Backend structure chart: each box is a module; an arrow means “calls”. Read top to bottom. Dashed boxes are libraries and outside services." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7C8A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;server.js&lt;/b&gt;&lt;br&gt;start-up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="675.0" y="110" width="170" height="62" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;config/env.js&lt;/b&gt;&lt;br&gt;load settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="475.0" y="222" width="170" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;app.js&lt;/b&gt;&lt;br&gt;request pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6EC;strokeColor=#2E6F8E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="875.0" y="222" width="170" height="62" as="geometry"/></mxCell><mxCell id="